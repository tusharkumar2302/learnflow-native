{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // "jsx": "react",
     "jsx": "react-native",
    "strict": true,
    "types": ["@hugeicons/core-free-icons", "@hugeicons/react-native"],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}